{
  "name": "function-sdk-node",
  "version": "0.0.5",
  "description": "TypeScript Node.js SDK",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "nodemon | pino-pretty",
    "start": "node dist/index.js",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write .",
    "clean": "rimraf dist",
    "generate": "buf generate",
    "render": "crossplane render resources/xr.yaml resources/composition.yaml resources/function.yaml -e resources/required.yaml"
  },
  "author": "Ruslan Sakal",
  "devDependencies": {
    "@types/node": "^20.19.32",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.5.5",
    "jest": "^29.0.0",
    "nodemon": "^3.1.11",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.3.3",
    "protoc-gen-ts": "^0.8.7",
    "rimraf": "^5.0.0",
    "ts-node": "^10.0.0",
    "ts-proto": "^2.11.2",
    "typescript": "^5.9.3",
    "@bufbuild/buf": "^1.65.0"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.11.0",
    "@grpc/grpc-js": "^1.14.3",
    "pino": "^10.3.0"
  }
}
